+/* Some libc variants expose bsd_signal() without a visible prototype unless
+   legacy feature macros are enabled.  Keep the configured HAVE_BSD_SIGNAL
+   path, but provide a declaration to avoid implicit-declaration build errors
+   with modern C compilers.  */
+#if defined(HAVE_BSD_SIGNAL) && !defined(bsd_signal)
+typedef RETSIGTYPE (*bsd_signal_ret_t) ();
+extern bsd_signal_ret_t bsd_signal (int sig, bsd_signal_ret_t func);
+#endif
+
 #if !defined HAVE_BSD_SIGNAL && !defined bsd_signal
 # if !defined HAVE_SIGACTION
 #  define bsd_signal signal
