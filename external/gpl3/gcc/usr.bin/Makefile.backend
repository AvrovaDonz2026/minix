#	$NetBSD: Makefile.backend,v 1.5 2014/04/04 01:19:14 christos Exp $

.ifndef _EXTERNAL_GPL3_GCC_USR_BIN_MAKEFILE_BACKEND_
_EXTERNAL_GPL3_GCC_USR_BIN_MAKEFILE_BACKEND_=1

NOMAN=		# defined
NOCTF=		# defined
BINDIR=		/usr/libexec

CPPFLAGS+=	-I${GCCARCH} -I${BACKENDOBJ} \
		${G_ALL_CFLAGS:M-D*} ${G_INCLUDES:M-I*:N-I.*}

.include <bsd.own.mk>
.include "Makefile.hostprobes"

DPADD+=			${BACKENDOBJ}/libbackend.a
LDADD+=			${BACKENDOBJ}/libbackend.a

.include "../Makefile.common"
.include "../Makefile.libiberty"

HOSTPROG_CXX=	1

TOOLSGCCOBJ!=	cd ${NETBSDSRCDIR}/tools/gcc && ${PRINTOBJDIR}
TOOLSGCCBUILD=	${TOOLSGCCOBJ}/build/gcc

# GCC13 expects generated backend headers from the backend objdir, but these
# programs still search GCCARCH first. Stage the generated headers locally so
# they win deterministically during dep generation and compilation.
DPSRCS+=	config.h auto-host.h tm.h options.h version.h bversion.h
.NOPATH:	config.h auto-host.h tm.h options.h version.h bversion.h
CLEANFILES+=	config.h auto-host.h tm.h options.h version.h bversion.h

config.h: ${TOOLSGCCBUILD}/config.h
	rm -f ${.TARGET}
	cp ${.ALLSRC} ${.TARGET}

auto-host.h: gcc13-auto-host-force ${TOOLSGCCBUILD}/auto-host.h ${.PARSEDIR}/Makefile.hostprobes
	rm -f ${.TARGET}
	cp ${TOOLSGCCBUILD}/auto-host.h ${.TARGET}
	{ \
		for fn in ${GCC13_TARGET_STDIO_UNLOCKED_MISSING}; do \
			echo "#undef HAVE_$${fn}_UNLOCKED"; \
			echo "#undef HAVE_DECL_$${fn}_UNLOCKED"; \
		done; \
		for fn in ${GCC13_TARGET_MALLOC_INFO_MISSING}; do \
			echo "#undef HAVE_$${fn}"; \
			echo "#undef HAVE_DECL_$${fn}"; \
		done; \
		for fn in ${GCC13_TARGET_DECL_FALLBACKS}; do \
			echo "#undef HAVE_$${fn}"; \
			echo "#define HAVE_DECL_$${fn} 0"; \
		done; \
	} >> ${.TARGET}

tm.h: ${TOOLSGCCBUILD}/tm.h
	rm -f ${.TARGET}
	cp ${.ALLSRC} ${.TARGET}

options.h: ${TOOLSGCCBUILD}/options.h
	rm -f ${.TARGET}
	cp ${.ALLSRC} ${.TARGET}

version.h: ${TOOLSGCCBUILD}/version.h
	rm -f ${.TARGET}
	cp ${.ALLSRC} ${.TARGET}

bversion.h: ${TOOLSGCCBUILD}/bversion.h
	rm -f ${.TARGET}
	cp ${.ALLSRC} ${.TARGET}

${SRCS:.cc=.d} ${SRCS:.cc=.o} ${SRCS:.c=.d} ${SRCS:.c=.o}: \
	config.h auto-host.h tm.h options.h

# Force using C++ for this
HOST_CC:=	${HOST_CXX}
CC:=		${CXX}
CFLAGS:=	${CXXFLAGS}

# Don't auto-frob .y or .l files.
.l.c .y.c .y.h:
	@true

# Find our (local) libraries
LIBGMPDIR!=	cd ${NETBSDSRCDIR}/external/lgpl3/gmp/lib/libgmp && ${PRINTOBJDIR}
LIBMPFRDIR!=	cd ${NETBSDSRCDIR}/external/lgpl3/mpfr/lib/libmpfr && ${PRINTOBJDIR}
LIBMPCDIR!=	cd ${NETBSDSRCDIR}/external/lgpl3/mpc/lib/libmpc && ${PRINTOBJDIR}

LIBGMP=		${LIBGMPDIR}/libgmp.a
LIBMPFR=	${LIBMPFRDIR}/libmpfr.a
LIBMPC=		${LIBMPCDIR}/libmpc.a

.include <bsd.prog.mk>

.endif
