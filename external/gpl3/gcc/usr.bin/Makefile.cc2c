# Map gcc13 .cc SRCS onto gcc 4.8.5 .c, and drop names the dist lacks.
#
# Hosted packaging fetches gcc 4.8.5. Native Makefiles still list gcc 13
# .cc objects. Keep generated options.cc. Rewrite each other .cc to .c
# when that basename exists in dist; drop it when neither exists.

.include "${.PARSEDIR}/Makefile.inc"

GCC_CC2C_DIRS= \
	${DIST}/gcc \
	${DIST}/gcc/c \
	${DIST}/gcc/c-family \
	${DIST}/gcc/cp \
	${DIST}/gcc/objc \
	${DIST}/gcc/lto \
	${DIST}/gcc/common \
	${DIST}/gcc/config \
	${DIST}/libiberty

GCC_SRCS_MAPPED=
.for s in ${SRCS}
.if ${s:E} != "cc"
GCC_SRCS_MAPPED+=	${s}
.else
_gcc_cc2c=
.for d in ${GCC_CC2C_DIRS}
.if empty(_gcc_cc2c)
.if exists(${d}/${s})
_gcc_cc2c=	${s}
.elif exists(${d}/${s:R}.c)
_gcc_cc2c=	${s:R}.c
.endif
.endif
.endfor
.if empty(_gcc_cc2c) && ${s} == "options.cc"
_gcc_cc2c=	${s}
.endif
.if !empty(_gcc_cc2c)
GCC_SRCS_MAPPED+=	${_gcc_cc2c}
.endif
.endif
.endfor
SRCS:=			${GCC_SRCS_MAPPED}
