#	$NetBSD: Makefile.gcc-tool,v 1.2 2014/05/31 22:55:16 mrg Exp $

PROG=	gcc-${GCC_TOOL}
SRCS=	gcc-${GCC_TOOL}.cc file-find.cc

CPPFLAGS= \
	-DPERSONALITY=\"${GCC_TOOL}\" \
	-DSTANDARD_EXEC_PREFIX=\"/usr/libexec/\" \
	-DSTANDARD_LIBEXEC_PREFIX=\"/usr/libexec/\" \
	-DSTANDARD_BINDIR_PREFIX=\"/usr/bin\" \
	-DTOOLDIR_BASE_PREFIX=\"../\" \
	-DDEFAULT_TARGET_MACHINE=\"${MACHINE_GNU_PLATFORM}\" \
	-DDEFAULT_TARGET_VERSION=\"${G_version}\"

# Skip these because we don't have them in paths.
#	-DDEFAULT_TARGET_VERSION=\"${G_version}\"
#	-DDEFAULT_TARGET_MACHINE=\"{GNU_MACHINE_ARCH}\"
#
# ${SRCS}: ${GCCARCH}/defs.mk

CPPFLAGS+=	-I${GCCARCH} -I${BACKENDOBJ} ${G_ALL_CFLAGS:M-D*} ${G_INCLUDES:M-I*:N-I.*}
.include "Makefile.hostprobes"

TOOLSGCCOBJ!=	cd ${NETBSDSRCDIR}/tools/gcc && ${PRINTOBJDIR}
TOOLSGCCBUILD=	${TOOLSGCCOBJ}/build/gcc

DPSRCS+=	config.h auto-host.h
.NOPATH:	config.h auto-host.h
CLEANFILES+=	config.h auto-host.h
.if ${GCC_TOOL} != "ar"
CLEANFILES+=	gcc-${GCC_TOOL}.cc
.endif

config.h: ${TOOLSGCCBUILD}/config.h
	rm -f ${.TARGET}
	cp ${.ALLSRC} ${.TARGET}

auto-host.h: gcc13-auto-host-force ${TOOLSGCCBUILD}/auto-host.h ${.PARSEDIR}/Makefile.hostprobes
	rm -f ${.TARGET}
	cp ${TOOLSGCCBUILD}/auto-host.h ${.TARGET}
	{ \
		for fn in ${GCC13_TARGET_STDIO_UNLOCKED_MISSING}; do \
			echo "#undef HAVE_$${fn}_UNLOCKED"; \
			echo "#undef HAVE_DECL_$${fn}_UNLOCKED"; \
		done; \
		for fn in ${GCC13_TARGET_MALLOC_INFO_MISSING}; do \
			echo "#undef HAVE_$${fn}"; \
			echo "#undef HAVE_DECL_$${fn}"; \
		done; \
		for fn in ${GCC13_TARGET_DECL_FALLBACKS}; do \
			echo "#undef HAVE_$${fn}"; \
			echo "#define HAVE_DECL_$${fn} 0"; \
		done; \
	} >> ${.TARGET}

.if ${GCC_TOOL} != "ar"
gcc-${GCC_TOOL}.cc: ${DIST}/gcc/gcc-ar.cc
	rm -f ${.TARGET}
	cp ${.ALLSRC} ${.TARGET}
.endif

${SRCS:.cc=.d} ${SRCS:.cc=.o}: config.h auto-host.h

BINDIR=		/usr/bin
NOMAN=		# defined

# Force using C++ for this
HOST_CC:=	${HOST_CXX}
CC:=		${CXX}
CFLAGS:=	${CXXFLAGS}

.include "../Makefile.common"
.include "../Makefile.libcpp"
.include "../Makefile.backtrace"
.include "../Makefile.libiberty"
.include "../Makefile.libdecnumber"

COPTS+=		-Wno-stack-protector

.PATH: ${DIST}/gcc

.include <bsd.prog.mk>
